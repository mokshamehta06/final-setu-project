<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Support | SETU</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/buttons.css">
  <link rel="stylesheet" href="/css/ui-enhancements.css">
  <style>
    :root {
      --support-bg: #f5fbff;
      --support-card: rgba(255,255,255,0.88);
      --support-border: rgba(14,165,233,0.12);
      --support-ink: #0f172a;
      --support-muted: #475569;
      --support-accent: #0ea5e9;
      --support-accent-dark: #0369a1;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: linear-gradient(180deg, #f0f9ff 0%, #eff6ff 20%, #f8fafc 100%);
      color: var(--support-ink);
    }

    .support-shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 48px 20px 72px;
    }

    .support-hero {
      position: relative;
      overflow: hidden;
      background: rgba(255,255,255,0.72);
      border: 1px solid var(--support-border);
      border-radius: 28px;
      box-shadow: 0 24px 45px rgba(15, 23, 42, 0.08);
      padding: 42px 40px;
      margin-bottom: 28px;
    }

    .support-hero::before {
      content: "";
      position: absolute;
      inset: -40% auto auto -12%;
      width: 260px;
      height: 260px;
      background: radial-gradient(circle, rgba(14,165,233,0.14), transparent 65%);
      pointer-events: none;
    }

    .support-hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 24px;
      align-items: center;
    }

    .support-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(14,165,233,0.1);
      color: var(--support-accent-dark);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 8px 12px;
      border-radius: 999px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .support-hero h1 {
      margin: 18px 0 14px;
      font-size: clamp(2.6rem, 5vw, 4rem);
      line-height: 0.98;
      letter-spacing: -0.06em;
      font-weight: 900;
      color: var(--support-ink);
    }

    .support-hero p {
      margin: 0;
      max-width: 620px;
      color: var(--support-muted);
      font-size: 1.08rem;
      line-height: 1.7;
    }

    .support-hero-actions {
      margin-top: 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .support-hero-panel {
      position: relative;
      background: linear-gradient(160deg, #0f172a 0%, #0b2540 100%);
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.22);
    }

    .support-panel-header {
      display: flex;
      gap: 8px;
      align-items: center;
      padding-bottom: 12px;
    }

    .support-panel-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .support-panel-dot:nth-child(1) { background: #34d399; }
    .support-panel-dot:nth-child(2) { background: #fbbf24; }
    .support-panel-dot:nth-child(3) { background: #60a5fa; }

    .support-panel-card {
      margin-top: 14px;
      background: rgba(148, 163, 184, 0.07);
      border: 1px solid rgba(148,163,184,0.15);
      border-radius: 18px;
      padding: 18px;
      color: white;
    }

    .support-panel-card strong {
      display: block;
      font-size: 2rem;
      margin-top: 8px;
    }

    .support-panel-card small {
      color: #bfdbfe;
      display: block;
      margin-top: 8px;
    }

    .support-metrics {
      margin-top: 18px;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .support-metric {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 14px;
      padding: 14px;
      color: white;
    }

    .support-metric span {
      display: block;
      color: #bfdbfe;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }

    .support-metric strong {
      font-size: 1.3rem;
    }

    .support-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin: 30px 0 26px;
    }

    .support-card {
      background: var(--support-card);
      border: 1px solid var(--support-border);
      border-radius: 22px;
      padding: 26px 22px;
      box-shadow: 0 14px 30px rgba(15,23,42,0.05);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .support-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 36px rgba(14,165,233,0.08);
    }

    .support-card-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--support-accent-dark), var(--support-accent));
      color: white;
      font-size: 1.5rem;
      box-shadow: 0 15px 25px rgba(14,165,233,0.25);
    }

    .support-card h3 {
      margin: 18px 0 10px;
      font-size: 1.35rem;
      color: var(--support-ink);
    }

    .support-card p {
      margin: 0 0 18px;
      color: var(--support-muted);
      line-height: 1.65;
    }

    .faq-section {
      margin-top: 10px;
    }

    .section-heading {
      margin: 0 0 18px;
      font-size: clamp(1.8rem, 3vw, 2.3rem);
      color: var(--support-ink);
      letter-spacing: -0.04em;
    }

    .faq-list {
      display: grid;
      gap: 14px;
    }

    .faq-item {
      background: rgba(255,255,255,0.8);
      border: 1px solid var(--support-border);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 10px 24px rgba(15,23,42,0.04);
    }

    .faq-question {
      padding: 20px 22px;
      font-weight: 700;
      color: var(--support-ink);
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .faq-question:hover {
      background: rgba(14,165,233,0.04);
    }

    .faq-question i {
      transition: transform 0.2s ease;
      color: var(--support-accent-dark);
    }

    .faq-question.active i {
      transform: rotate(180deg);
    }

    .faq-answer {
      background: rgba(240,249,255,0.9);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.28s ease, padding 0.28s ease;
      padding: 0 22px;
    }

    .faq-answer.active {
      max-height: 220px;
      padding: 0 22px 20px;
    }

    .faq-answer p {
      margin: 0;
      color: var(--support-muted);
      line-height: 1.7;
    }

    .contact-section {
      margin-top: 36px;
      background: rgba(255,255,255,0.86);
      border: 1px solid var(--support-border);
      border-radius: 24px;
      padding: 28px 22px;
      box-shadow: 0 16px 35px rgba(15,23,42,0.05);
    }

    .contact-form {
      display: grid;
      gap: 16px;
      max-width: 760px;
      margin: 0 auto;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .form-group {
      display: grid;
      gap: 8px;
    }

    .form-label {
      font-weight: 600;
      color: var(--support-ink);
    }

    .form-input,
    .form-textarea {
      width: 100%;
      border: 1px solid rgba(148,163,184,0.4);
      border-radius: 14px;
      padding: 14px 16px;
      font: inherit;
      background: rgba(248,250,252,0.9);
      color: var(--support-ink);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-input:focus,
    .form-textarea:focus {
      outline: none;
      border-color: rgba(14,165,233,0.7);
      box-shadow: 0 0 0 4px rgba(14,165,233,0.12);
      background: white;
    }

    .form-textarea {
      min-height: 160px;
      resize: vertical;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0.8rem 1.4rem;
      border-radius: 999px;
      font-weight: 700;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }

    .btn-primary {
      background: linear-gradient(135deg, #0369a1, #0ea5e9);
      color: white;
      box-shadow: 0 14px 26px rgba(14,165,233,0.2);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 18px 30px rgba(14,165,233,0.24);
    }

    .btn-block {
      width: 100%;
    }

    @media (max-width: 900px) {
      .support-hero-grid,
      .support-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .support-shell {
        padding-left: 14px;
        padding-right: 14px;
      }

      .support-hero,
      .support-card,
      .contact-section {
        border-radius: 20px;
      }

      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="support-shell">
    <div class="support-hero">
      <div class="support-hero-grid">
        <div>
          <span class="support-kicker"><i class="fas fa-headset"></i> Support Center</span>
          <h1>We’re here to help.</h1>
          <p>
            Whether you need product guidance, account help, or technical support, SETU makes it easy to get the right answer fast.
          </p>
          <div class="support-hero-actions">
            <a href="#contact-form" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Contact Support</a>
            <a href="#faq" class="btn" style="background:#fff;border:1px solid rgba(14,165,233,0.18);color:#0369a1;">Browse FAQs</a>
          </div>
        </div>

        <div class="support-hero-panel">
          <div class="support-panel-header">
            <span class="support-panel-dot"></span>
            <span class="support-panel-dot"></span>
            <span class="support-panel-dot"></span>
          </div>

          <div class="support-panel-card">
            <span style="color:#bfdbfe;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;">Average response</span>
            <strong>12 mins</strong>
            <small>Support team availability: 24/7</small>
          </div>

          <div class="support-metrics">
            <div class="support-metric">
              <span>Tickets</span>
              <strong>2.4k</strong>
            </div>
            <div class="support-metric">
              <span>Resolved</span>
              <strong>96%</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="support-grid">
      <div class="support-card">
        <div class="support-card-icon"><i class="fas fa-book"></i></div>
        <h3>Knowledge Base</h3>
        <p>Explore helpful guides, onboarding steps, and platform tips to resolve common issues quickly.</p>
        <a href="#faq" class="btn btn-primary"><i class="fas fa-arrow-right"></i> View Articles</a>
      </div>

      <div class="support-card">
        <div class="support-card-icon"><i class="fas fa-headset"></i></div>
        <h3>Customer Support</h3>
        <p>Connect with our team for order, account, or technical assistance with a faster response workflow.</p>
        <a href="#contact-form" class="btn btn-primary"><i class="fas fa-arrow-right"></i> Contact Us</a>
      </div>

      <div class="support-card">
        <div class="support-card-icon"><i class="fas fa-comments"></i></div>
        <h3>Community Help</h3>
        <p>Join the conversation and discover practical tips shared by other customers and agency partners.</p>
        <a href="#faq" class="btn btn-primary"><i class="fas fa-arrow-right"></i> Explore Help</a>
      </div>
    </div>

    <div class="faq-section" id="faq">
      <h2 class="section-heading">Frequently asked questions</h2>

      <div class="faq-list">
        <div class="faq-item">
          <div class="faq-question"><span>How do I create an account?</span><i class="fas fa-chevron-down"></i></div>
          <div class="faq-answer"><p>Choose the Customer or Agency portal from the homepage, complete the sign-up form, and follow the verification steps provided in your dashboard.</p></div>
        </div>

        <div class="faq-item">
          <div class="faq-question"><span>What is the difference between customer and agency accounts?</span><i class="fas fa-chevron-down"></i></div>
          <div class="faq-answer"><p>Customer accounts are for browsing and purchasing products. Agency accounts unlock operations for listing, managing, and fulfilling products through a dedicated dashboard.</p></div>
        </div>

        <div class="faq-item">
          <div class="faq-question"><span>How do I reset my password?</span><i class="fas fa-chevron-down"></i></div>
          <div class="faq-answer"><p>Use the Forgot Password link on the login page, submit your email, and follow the reset instructions sent to your inbox.</p></div>
        </div>

        <div class="faq-item">
          <div class="faq-question"><span>How can I contact customer support?</span><i class="fas fa-chevron-down"></i></div>
          <div class="faq-answer"><p>Send a message through the form below or use the embedded voice assistant for quick support guidance while you browse the platform.</p></div>
        </div>

        <div class="faq-item">
          <div class="faq-question"><span>How long does agency verification take?</span><i class="fas fa-chevron-down"></i></div>
          <div class="faq-answer"><p>The review process usually takes 3–5 business days, depending on document completeness and verification requirements.</p></div>
        </div>
      </div>
    </div>

    <div class="contact-section" id="contact-form">
      <h2 class="section-heading" style="text-align:center; margin-bottom: 22px;">Contact us</h2>
      <form class="contact-form" action="/support/contact" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label for="name" class="form-label">Your Name</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="Enter your name" required>
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="Enter your email" required>
          </div>
        </div>

        <div class="form-group">
          <label for="subject" class="form-label">Subject</label>
          <input type="text" id="subject" name="subject" class="form-input" placeholder="What do you need help with?" required>
        </div>

        <div class="form-group">
          <label for="message" class="form-label">Message</label>
          <textarea id="message" name="message" class="form-textarea" placeholder="Tell us how we can help you" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          <i class="fas fa-paper-plane"></i>
          <span>Send Message</span>
        </button>
      </form>
    </div>
  </div>

  <script src="https://embedded-voice-assistant.onrender.com/assistant.js" data-user-id="6ab6a7796589f3f11afa63be"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.faq-question').forEach((question) => {
        question.addEventListener('click', function () {
          const answer = this.nextElementSibling;
          const isOpen = this.classList.contains('active');

          document.querySelectorAll('.faq-question').forEach((item) => {
            item.classList.remove('active');
            if (item.nextElementSibling) {
              item.nextElementSibling.classList.remove('active');
            }
          });

          if (!isOpen) {
            this.classList.add('active');
            answer.classList.add('active');
          }
        });
      });
    });
  </script>
</body>
</html>
