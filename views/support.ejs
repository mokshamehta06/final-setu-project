<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Support Center | SETU</title>
  <meta name="description" content="Get help with your SETU account, orders, and seized goods inquiries. Browse FAQs or contact our 24/7 support team.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/ui-enhancements.css">
  <style>
    :root {
      --sp-accent: #0ea5e9;
      --sp-accent-dark: #0369a1;
      --sp-ink: #0f172a;
      --sp-muted: #475569;
      --sp-card-bg: rgba(255,255,255,0.92);
      --sp-border: rgba(14,165,233,0.13);
      --sp-radius: 1.4rem;
    }

    body {
      background: linear-gradient(170deg,#f0f9ff 0%,#eff6ff 30%,#f8fafc 100%);
      font-family: 'Plus Jakarta Sans','Inter',sans-serif;
      color: var(--sp-ink);
    }

    /* ── Hero ── */
    .sp-hero {
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg,#0b1120 0%,#0c2340 55%,#0369a1 100%);
      padding: 80px 0 60px;
    }
    .sp-hero::before {
      content:'';position:absolute;width:600px;height:600px;border-radius:50%;
      background:radial-gradient(circle,rgba(56,189,248,.18),transparent 65%);
      top:-180px;right:-100px;pointer-events:none;
    }
    .sp-hero::after {
      content:'';position:absolute;width:400px;height:400px;border-radius:50%;
      background:radial-gradient(circle,rgba(99,102,241,.12),transparent 65%);
      bottom:-100px;left:-80px;pointer-events:none;
    }
    .sp-hero-inner { position:relative;z-index:2; }

    .sp-kicker {
      display:inline-flex;align-items:center;gap:8px;
      background:rgba(56,189,248,.18);border:1px solid rgba(56,189,248,.3);
      color:#7dd3fc;font-size:.75rem;font-weight:700;letter-spacing:.08em;
      text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:20px;
    }

    .sp-hero h1 {
      font-size:clamp(2.4rem,5vw,3.6rem);font-weight:800;color:#fff;
      line-height:1.1;letter-spacing:-.04em;margin-bottom:16px;
    }
    .sp-hero h1 span {
      background:linear-gradient(135deg,#38bdf8,#818cf8);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    }
    .sp-hero p { color:rgba(255,255,255,.65);font-size:1.08rem;max-width:520px;line-height:1.7;margin-bottom:28px; }

    .sp-hero-btns { display:flex;flex-wrap:wrap;gap:12px; }

    .btn-sp-primary {
      display:inline-flex;align-items:center;gap:8px;
      background:linear-gradient(135deg,#0369a1,#0ea5e9);color:#fff;
      font-weight:700;font-size:.95rem;padding:12px 24px;border-radius:999px;
      border:none;cursor:pointer;text-decoration:none;
      transition:transform .2s,box-shadow .2s;
      box-shadow:0 12px 28px rgba(14,165,233,.35);
    }
    .btn-sp-primary:hover { transform:translateY(-2px);box-shadow:0 18px 35px rgba(14,165,233,.4);color:#fff; }

    .btn-sp-ghost {
      display:inline-flex;align-items:center;gap:8px;
      background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
      color:rgba(255,255,255,.85);font-weight:600;font-size:.95rem;
      padding:12px 24px;border-radius:999px;text-decoration:none;
      transition:background .2s,transform .2s;
    }
    .btn-sp-ghost:hover { background:rgba(255,255,255,.15);color:#fff;transform:translateY(-2px); }

    /* Hero Panel */
    .sp-panel {
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
      backdrop-filter:blur(14px);border-radius:1.25rem;padding:24px;
    }
    .sp-panel-dots { display:flex;gap:8px;margin-bottom:16px;align-items:center; }
    .sp-dot { width:10px;height:10px;border-radius:50%;display:inline-block; }
    .sp-dot-1{background:#34d399;} .sp-dot-2{background:#fbbf24;} .sp-dot-3{background:#60a5fa;}
    .sp-panel-title { color:rgba(255,255,255,.5);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700; }

    /* ── Stats Strip ── */
    .sp-stats { background:#fff;border-bottom:1px solid rgba(14,165,233,.1);padding:20px 0;box-shadow:0 4px 20px rgba(15,23,42,.05); }
    .sp-stat { text-align:center;padding:8px 20px;border-right:1px solid rgba(148,163,184,.2); }
    .sp-stat:last-child { border-right:none; }
    .sp-stat-val { font-size:1.6rem;font-weight:800;color:var(--sp-accent-dark);line-height:1;margin-bottom:4px; }
    .sp-stat-lbl { font-size:.75rem;color:var(--sp-muted);font-weight:600;text-transform:uppercase;letter-spacing:.04em; }

    /* ── Sections ── */
    .sp-section { padding:64px 0; }
    .sp-section-header { text-align:center;margin-bottom:44px; }
    .sp-sec-kicker {
      display:inline-flex;align-items:center;gap:6px;
      background:rgba(14,165,233,.08);color:var(--sp-accent-dark);
      font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
      padding:5px 14px;border-radius:999px;border:1px solid rgba(14,165,233,.14);margin-bottom:14px;
    }
    .sp-sec-title { font-size:clamp(1.8rem,3vw,2.4rem);font-weight:800;letter-spacing:-.035em;color:var(--sp-ink);margin-bottom:12px; }
    .sp-sec-desc { color:var(--sp-muted);font-size:1rem;max-width:560px;margin:0 auto;line-height:1.7; }

    /* ── Channel Cards ── */
    .sp-channels { display:grid;grid-template-columns:repeat(3,1fr);gap:24px; }
    .sp-channel-card {
      background:var(--sp-card-bg);border:1px solid var(--sp-border);border-radius:var(--sp-radius);
      padding:32px 28px;box-shadow:0 8px 28px rgba(15,23,42,.06);
      transition:transform .22s,box-shadow .22s;position:relative;overflow:hidden;
    }
    .sp-channel-card::before {
      content:'';position:absolute;top:0;left:0;right:0;height:3px;
      background:linear-gradient(90deg,var(--sp-accent-dark),var(--sp-accent));
      border-radius:var(--sp-radius) var(--sp-radius) 0 0;
    }
    .sp-channel-card:hover { transform:translateY(-5px);box-shadow:0 18px 42px rgba(14,165,233,.12); }
    .sp-ch-icon {
      width:56px;height:56px;border-radius:16px;
      background:linear-gradient(135deg,var(--sp-accent-dark),var(--sp-accent));
      color:#fff;font-size:1.4rem;display:flex;align-items:center;justify-content:center;
      margin-bottom:20px;box-shadow:0 12px 24px rgba(14,165,233,.28);
    }
    .sp-channel-card h3 { font-size:1.2rem;font-weight:700;color:var(--sp-ink);margin-bottom:10px; }
    .sp-channel-card p { color:var(--sp-muted);font-size:.9rem;line-height:1.7;margin-bottom:22px; }
    .btn-sp-outline {
      display:inline-flex;align-items:center;gap:8px;
      background:transparent;border:1.5px solid rgba(14,165,233,.35);
      color:var(--sp-accent-dark);font-weight:700;font-size:.88rem;
      padding:9px 20px;border-radius:999px;text-decoration:none;transition:all .2s;
    }
    .btn-sp-outline:hover { background:var(--sp-accent-dark);color:#fff;border-color:var(--sp-accent-dark); }

    /* ── FAQ ── */
    .sp-faq-bg { background:linear-gradient(135deg,#f8fafc,#f0f9ff);border-top:1px solid rgba(14,165,233,.08);border-bottom:1px solid rgba(14,165,233,.08); }
    .sp-faq-grid { display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:980px;margin:0 auto; }
    .sp-faq-item { background:#fff;border:1px solid rgba(148,163,184,.18);border-radius:1.1rem;overflow:hidden;box-shadow:0 4px 16px rgba(15,23,42,.04); }
    .sp-faq-q {
      padding:18px 22px;font-weight:700;font-size:.95rem;color:var(--sp-ink);
      display:flex;justify-content:space-between;align-items:center;gap:12px;
      cursor:pointer;user-select:none;transition:background .18s;
    }
    .sp-faq-q:hover { background:rgba(14,165,233,.04); }
    .sp-faq-icon { color:var(--sp-accent-dark);transition:transform .22s;flex-shrink:0; }
    .sp-faq-q.open .sp-faq-icon { transform:rotate(45deg); }
    .sp-faq-a {
      max-height:0;overflow:hidden;transition:max-height .3s ease,padding .3s ease;
      background:rgba(240,249,255,.7);border-top:1px solid rgba(14,165,233,.08);padding:0 22px;
    }
    .sp-faq-a.open { max-height:220px;padding:16px 22px; }
    .sp-faq-a p { margin:0;color:var(--sp-muted);font-size:.9rem;line-height:1.7; }

    /* ── Contact ── */
    .sp-contact {
      background:linear-gradient(135deg,#0b1120,#0c2340);
      padding:72px 0;position:relative;overflow:hidden;
    }
    .sp-contact::before {
      content:'';position:absolute;width:500px;height:500px;border-radius:50%;
      background:radial-gradient(circle,rgba(14,165,233,.14),transparent 65%);
      top:-150px;right:-100px;pointer-events:none;
    }
    .sp-contact-inner { position:relative;z-index:2; }
    .sp-contact-title { color:#fff;font-size:clamp(1.8rem,3vw,2.4rem);font-weight:800;letter-spacing:-.04em;margin-bottom:10px; }
    .sp-contact-desc { color:rgba(255,255,255,.6);font-size:.98rem;margin-bottom:0; }

    .sp-form-card {
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
      backdrop-filter:blur(16px);border-radius:1.5rem;padding:36px 32px;
    }
    .sp-form-label { display:block;font-weight:600;font-size:.85rem;color:rgba(255,255,255,.8);margin-bottom:7px; }
    .sp-form-input, .sp-form-select, .sp-form-textarea {
      width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);
      border-radius:.8rem;padding:13px 16px;color:#fff;font-size:.93rem;font-family:inherit;
      transition:border-color .2s,box-shadow .2s,background .2s;
    }
    .sp-form-input::placeholder,.sp-form-textarea::placeholder { color:rgba(255,255,255,.3); }
    .sp-form-input:focus,.sp-form-select:focus,.sp-form-textarea:focus {
      outline:none;border-color:rgba(56,189,248,.6);
      box-shadow:0 0 0 4px rgba(56,189,248,.12);background:rgba(255,255,255,.1);
    }
    .sp-form-select option { background:#1e293b;color:#fff; }
    .sp-form-textarea { min-height:130px;resize:vertical; }
    .btn-sp-submit {
      width:100%;padding:14px;background:linear-gradient(135deg,#0369a1,#0ea5e9);
      color:#fff;font-weight:700;font-size:1rem;border:none;border-radius:.85rem;
      cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;
      transition:transform .2s,box-shadow .2s;box-shadow:0 12px 28px rgba(14,165,233,.35);
    }
    .btn-sp-submit:hover { transform:translateY(-2px);box-shadow:0 18px 36px rgba(14,165,233,.42); }

    /* ── Trust Bar ── */
    .sp-trust { background:#fff;padding:36px 0;border-top:1px solid rgba(148,163,184,.14); }
    .sp-trust-item { display:flex;align-items:center;gap:14px;padding:0 24px;border-right:1px solid rgba(148,163,184,.18); }
    .sp-trust-item:last-child { border-right:none; }
    .sp-trust-icon {
      width:44px;height:44px;border-radius:12px;
      background:linear-gradient(135deg,#e0f2fe,#bfdbfe);
      display:flex;align-items:center;justify-content:center;
      color:var(--sp-accent-dark);font-size:1.1rem;flex-shrink:0;
    }
    .sp-trust-text strong { display:block;font-weight:700;color:var(--sp-ink);font-size:.9rem;margin-bottom:2px; }
    .sp-trust-text span { color:var(--sp-muted);font-size:.78rem; }

    /* ── Responsive ── */
    @media (max-width:992px) {
      .sp-channels { grid-template-columns:1fr 1fr; }
      .sp-faq-grid { grid-template-columns:1fr; }
    }
    @media (max-width:640px) {
      .sp-channels { grid-template-columns:1fr; }
      .sp-hero { padding:60px 0 40px; }
      .sp-form-card { padding:24px 18px; }
      .sp-stat { border-right:none;padding:8px 10px; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero -->
  <section class="sp-hero">
    <div class="container sp-hero-inner">
      <div class="row align-items-center g-5">
        <div class="col-lg-7">
          <span class="sp-kicker"><i class="fas fa-headset"></i> SETU Support Center</span>
          <h1>We're here to<br><span>help you.</span></h1>
          <p>Get answers quickly — whether you need help with an order, account access, a seized goods inquiry, or agency verification.</p>
          <div class="sp-hero-btns">
            <a href="#contact-form" class="btn-sp-primary"><i class="fas fa-paper-plane"></i> Send a Message</a>
            <a href="#faq" class="btn-sp-ghost"><i class="fas fa-search"></i> Browse FAQs</a>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="sp-panel">
            <div class="sp-panel-dots">
              <span class="sp-dot sp-dot-1"></span>
              <span class="sp-dot sp-dot-2"></span>
              <span class="sp-dot sp-dot-3"></span>
              <span class="ms-2 sp-panel-title">Support Dashboard</span>
            </div>
            <div class="mb-3 p-3 rounded-3" style="background:rgba(14,165,233,.1);border:1px solid rgba(56,189,248,.2);">
              <div style="color:#7dd3fc;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;font-weight:700;">Avg. Response Time</div>
              <div class="text-white fw-bold" style="font-size:2rem;line-height:1.1;margin-top:4px;">12 mins</div>
              <small style="color:#bfdbfe;">Available 24 × 7</small>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <div class="p-3 rounded-3 text-center" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);">
                  <div class="text-white fw-bold fs-4">2.4k</div>
                  <small style="color:#bfdbfe;">Tickets</small>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 rounded-3 text-center" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);">
                  <div class="text-white fw-bold fs-4">96%</div>
                  <small style="color:#bfdbfe;">Resolved</small>
                </div>
              </div>
            </div>
            <div class="mt-3 d-flex align-items-center gap-2">
              <div class="d-flex align-items-center justify-content-center rounded-circle text-white" style="width:32px;height:32px;background:linear-gradient(135deg,#0369a1,#0ea5e9);flex-shrink:0;font-size:.8rem;">
                <i class="fas fa-robot"></i>
              </div>
              <div class="p-2 rounded-3 small flex-grow-1" style="background:rgba(255,255,255,.07);color:rgba(255,255,255,.75);">
                "Hello! How can I assist you today?"
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <div class="sp-stats">
    <div class="container">
      <div class="row g-0 justify-content-center">
        <div class="col-6 col-md-3"><div class="sp-stat"><div class="sp-stat-val">24/7</div><div class="sp-stat-lbl">Support Hours</div></div></div>
        <div class="col-6 col-md-3"><div class="sp-stat"><div class="sp-stat-val">12 min</div><div class="sp-stat-lbl">Avg Response</div></div></div>
        <div class="col-6 col-md-3"><div class="sp-stat"><div class="sp-stat-val">96%</div><div class="sp-stat-lbl">Resolution Rate</div></div></div>
        <div class="col-6 col-md-3"><div class="sp-stat"><div class="sp-stat-val">4.9 ★</div><div class="sp-stat-lbl">Customer Rating</div></div></div>
      </div>
    </div>
  </div>

  <!-- Support Channels -->
  <section class="sp-section">
    <div class="container">
      <div class="sp-section-header">
        <div class="sp-sec-kicker"><i class="fas fa-bolt"></i> How We Help</div>
        <h2 class="sp-sec-title">Choose Your Support Channel</h2>
        <p class="sp-sec-desc">Multiple ways to get the help you need — fast, reliable, and tailored for SETU citizens and agencies.</p>
      </div>
      <div class="sp-channels">
        <div class="sp-channel-card">
          <div class="sp-ch-icon"><i class="fas fa-book-open"></i></div>
          <h3>Knowledge Base</h3>
          <p>Browse structured guides, how-to articles, and onboarding walkthroughs to resolve issues on your own, any time.</p>
          <a href="#faq" class="btn-sp-outline"><i class="fas fa-arrow-right"></i> View Articles</a>
        </div>
        <div class="sp-channel-card">
          <div class="sp-ch-icon"><i class="fas fa-headset"></i></div>
          <h3>Live Support</h3>
          <p>Connect with our trained support team for real-time assistance on orders, accounts, or payment escrow queries.</p>
          <a href="#contact-form" class="btn-sp-outline"><i class="fas fa-arrow-right"></i> Contact Now</a>
        </div>
        <div class="sp-channel-card">
          <div class="sp-ch-icon"><i class="fas fa-robot"></i></div>
          <h3>AI Assistant</h3>
          <p>Use our embedded AI voice assistant to get instant answers on product availability, order status, and platform guidance.</p>
          <a href="#" class="btn-sp-outline" onclick="return false;"><i class="fas fa-arrow-right"></i> Coming Soon</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sp-faq-bg sp-section" id="faq">
    <div class="container">
      <div class="sp-section-header">
        <div class="sp-sec-kicker"><i class="fas fa-question-circle"></i> Common Questions</div>
        <h2 class="sp-sec-title">Frequently Asked Questions</h2>
        <p class="sp-sec-desc">Quick answers to common questions about the SETU platform, orders, and accounts.</p>
      </div>
      <div class="sp-faq-grid">
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>How do I create a customer account?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Click "Sign In" in the top-right corner and choose "Create Account." Fill in your details, verify your email, and start browsing the SETU seized goods catalog.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>What is the difference between customer and agency accounts?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Customer accounts are for browsing, purchasing, and tracking orders. Agency accounts are for government-authorized organizations to list and manage seized asset inventories.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>How does escrow payment protection work?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Your payment is held in trust when you place an order. Funds are only released to the agency after you confirm the item matches the official seizure manifest upon delivery.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>How do I reset my password?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Click "Forgot Password" on the login page, enter your registered email, and follow the secure reset link sent to your inbox. Links expire after 1 hour.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>Are all products officially verified?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Yes. Every product is sourced from government-authorized disposal agencies, inspected against official seizure manifests, and issued a disposal clearance certificate.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>How long does agency verification take?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>The admin review typically takes 3–5 business days depending on document completeness. You'll be notified by email once your agency is approved.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>Can I return a seized product?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Returns are accepted within 7 days if the item significantly differs from the listed condition or seizure manifest. Contact support immediately upon delivery.</p></div>
        </div>
        <div class="sp-faq-item">
          <div class="sp-faq-q"><span>How can I track my order?</span><i class="fas fa-plus sp-faq-icon"></i></div>
          <div class="sp-faq-a"><p>Log in to your customer account and go to "My Orders" in your dashboard. Each order shows a live status timeline from placement to delivery.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="sp-contact" id="contact-form">
    <div class="container sp-contact-inner">
      <div class="row align-items-start g-5">
        <div class="col-lg-5">
          <div class="sp-sec-kicker d-inline-flex mb-3" style="background:rgba(56,189,248,.15);border-color:rgba(56,189,248,.3);color:#7dd3fc;">
            <i class="fas fa-paper-plane"></i> Get In Touch
          </div>
          <h2 class="sp-contact-title">Still have questions?<br>We're here.</h2>
          <p class="sp-contact-desc">Our team responds to all inquiries within 12 minutes on average.</p>
          <div class="mt-4 d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-3">
              <div class="sp-ch-icon" style="width:42px;height:42px;border-radius:12px;font-size:1rem;flex-shrink:0;margin-bottom:0;">
                <i class="fas fa-envelope"></i>
              </div>
              <div>
                <div class="fw-bold text-white" style="font-size:.85rem;">Email Support</div>
                <div style="color:rgba(255,255,255,.55);font-size:.82rem;">support@setu.gov.in</div>
              </div>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="sp-ch-icon" style="width:42px;height:42px;border-radius:12px;font-size:1rem;flex-shrink:0;margin-bottom:0;">
                <i class="fas fa-phone"></i>
              </div>
              <div>
                <div class="fw-bold text-white" style="font-size:.85rem;">Toll-Free Helpline</div>
                <div style="color:rgba(255,255,255,.55);font-size:.82rem;">1800-XXX-SETU (Mon–Sat, 9am–6pm)</div>
              </div>
            </div>
            <div class="d-flex align-items-center gap-3">
              <div class="sp-ch-icon" style="width:42px;height:42px;border-radius:12px;font-size:1rem;flex-shrink:0;margin-bottom:0;">
                <i class="fas fa-shield-alt"></i>
              </div>
              <div>
                <div class="fw-bold text-white" style="font-size:.85rem;">Grievance Officer</div>
                <div style="color:rgba(255,255,255,.55);font-size:.82rem;">grievance@setu.gov.in</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="sp-form-card">
            <form action="/support/contact" method="POST">
              <div class="row g-3 mb-3">
                <div class="col-sm-6">
                  <label class="sp-form-label">Your Name</label>
                  <input type="text" name="name" class="sp-form-input" placeholder="Full name" required>
                </div>
                <div class="col-sm-6">
                  <label class="sp-form-label">Email Address</label>
                  <input type="email" name="email" class="sp-form-input" placeholder="you@example.com" required>
                </div>
              </div>
              <div class="row g-3 mb-3">
                <div class="col-sm-6">
                  <label class="sp-form-label">Phone (Optional)</label>
                  <input type="tel" name="phone" class="sp-form-input" placeholder="+91 XXXXXXXXXX">
                </div>
                <div class="col-sm-6">
                  <label class="sp-form-label">Category</label>
                  <select name="category" class="sp-form-input sp-form-select" required>
                    <option value="">Select a topic...</option>
                    <option value="order">Order Issue</option>
                    <option value="account">Account / Login</option>
                    <option value="payment">Payment / Escrow</option>
                    <option value="product">Product Query</option>
                    <option value="agency">Agency Verification</option>
                    <option value="other">Other</option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <label class="sp-form-label">Subject</label>
                <input type="text" name="subject" class="sp-form-input" placeholder="Brief description of your issue" required>
              </div>
              <div class="mb-4">
                <label class="sp-form-label">Message</label>
                <textarea name="message" class="sp-form-input sp-form-textarea" placeholder="Please describe your issue in detail. Include order numbers if relevant." required></textarea>
              </div>
              <button type="submit" class="btn-sp-submit">
                <i class="fas fa-paper-plane"></i> Send Message
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="sp-trust">
    <div class="container">
      <div class="row g-3">
        <div class="col-6 col-md-3">
          <div class="sp-trust-item">
            <div class="sp-trust-icon"><i class="fas fa-lock"></i></div>
            <div class="sp-trust-text"><strong>Escrow Protected</strong><span>Payments held in trust</span></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="sp-trust-item">
            <div class="sp-trust-icon"><i class="fas fa-shield-alt"></i></div>
            <div class="sp-trust-text"><strong>Government Backed</strong><span>Authorized disposal only</span></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="sp-trust-item">
            <div class="sp-trust-icon"><i class="fas fa-certificate"></i></div>
            <div class="sp-trust-text"><strong>100% Verified</strong><span>Certified chain of custody</span></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="sp-trust-item">
            <div class="sp-trust-icon"><i class="fas fa-headset"></i></div>
            <div class="sp-trust-text"><strong>24/7 Support</strong><span>Always available for you</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://embedded-voice-assistant.onrender.com/assistant.js" data-user-id="6ab6a7796589f3f11afa63be"></script>
  <script>
    document.querySelectorAll('.sp-faq-q').forEach(q => {
      q.addEventListener('click', function () {
        const answer = this.nextElementSibling;
        const isOpen = this.classList.contains('open');
        document.querySelectorAll('.sp-faq-q').forEach(item => {
          item.classList.remove('open');
          if (item.nextElementSibling) item.nextElementSibling.classList.remove('open');
        });
        if (!isOpen) { this.classList.add('open'); answer.classList.add('open'); }
      });
    });
  </script>
</body>
</html>
