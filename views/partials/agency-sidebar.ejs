<div class="sidebar">
    <div class="logo">
        <a href="/agency/dashboard" class="d-flex align-items-center text-white text-decoration-none px-3 py-2">
            <div class="logo-icon bg-primary text-white rounded p-2 me-2">
                <i class="fas fa-building"></i>
            </div>
            <span class="fw-bold fs-5">SETU Agency</span>
        </a>
    </div>
    <nav class="sidebar-nav">
        <ul>
            <li class="<%= (typeof page !== 'undefined' && page === 'dashboard') ? 'active' : '' %>">
                <a href="/agency/dashboard"><i class="fas fa-home"></i> <span>Dashboard</span></a>
            </li>
            <li class="<%= (typeof page !== 'undefined' && page === 'products') ? 'active' : '' %>">
                <a href="/agency/products"><i class="fas fa-box"></i> <span>Products</span></a>
            </li>
            <li class="<%= (typeof page !== 'undefined' && page === 'orders') ? 'active' : '' %>">
                <a href="/agency/orders"><i class="fas fa-shopping-cart"></i> <span>Orders</span></a>
            </li>
            <li class="<%= (typeof page !== 'undefined' && page === 'verification') ? 'active' : '' %> <%= (typeof user === 'undefined' || !user || !user.isVerified) ? 'needs-verification' : '' %>">
                <a href="/agency/verification">
                    <% if (typeof user === 'undefined' || !user || !user.isVerified) { %>
                        <i class="fas fa-exclamation-circle"></i> <span>Verification</span>
                        <span class="verification-badge">Required</span>
                    <% } else { %>
                        <i class="fas fa-check-circle"></i> <span>Verification</span>
                    <% } %>
                </a>
            </li>
            <li class="<%= (typeof page !== 'undefined' && page === 'settings') ? 'active' : '' %>">
                <a href="/agency/settings"><i class="fas fa-cog"></i> <span>Settings</span></a>
            </li>
            <li class="<%= (typeof page !== 'undefined' && page === 'support') ? 'active' : '' %>">
                <a href="/agency/support"><i class="fas fa-question-circle"></i> <span>Support</span></a>
            </li>
        </ul>
    </nav>
</div>