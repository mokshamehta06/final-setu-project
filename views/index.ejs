<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SETU</title>
  <!-- Google Fonts & Font Awesome -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Custom Design Tokens & UI -->
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/buttons.css">
  <link rel="stylesheet" href="/css/ui-enhancements.css">
  <style>
    .form-group {
  margin-bottom: 1.5rem;
  position: relative;
}

.form-control {
  width: 100%;
  padding: 0.75rem 1rem;
  font-size: 1rem;
  border: 1px solid #ddd;
  border-radius: 4px;
  transition: border-color 0.3s ease;
}

.form-control.error {
  border-color: #dc3545;
}

.error-message {
  color: #dc3545;
  font-size: 0.875rem;
  margin-top: 0.25rem;
  min-height: 1.25rem;
}

.hidden {
  display: none;
}

.alert {
  padding: 1rem;
  margin-bottom: 1rem;
  border-radius: 4px;
}

.alert-danger {
  background-color: #f8d7da;
  border: 1px solid #f5c6cb;
  color: #721c24;
}

.alert-success {
  background-color: #d4edda;
  border: 1px solid #c3e6cb;
  color: #155724;
}

/* Password strength indicator */
.password-strength {
  height: 4px;
  margin-top: 0.5rem;
  border-radius: 2px;
  transition: all 0.3s ease;
}

.password-strength.weak {
  background-color: #dc3545;
  width: 33%;
}

.password-strength.medium {
  background-color: #ffc107;
  width: 66%;
}

.password-strength.strong {
  background-color: #28a745;
  width: 100%;
}

  </style>
</head>
<body>
  <% if(page !== 'customer-login' && page !== 'customer-register' && page !== 'agency-login' && page !== 'agency-register') { %>
    <%- include('partials/header') %>
  <% } %>

  <!-- Flash Messages -->
  <% if(success_msg && success_msg.length > 0) { %>
    <div class="notification success visible">
      <%= success_msg %>
    </div>
  <% } %>

  <% if(error_msg && error_msg.length > 0) { %>
    <div class="notification error visible">
      <%= error_msg %>
    </div>
  <% } %>

  <!-- Home Page -->
  <% if(page === 'home') { %>

    <!-- Announcement Bar -->
    <div class="py-2 px-3 text-center text-white small fw-bold" style="background: linear-gradient(90deg, #0c4a6e 0%, #0284c7 50%, #0369a1 100%); letter-spacing: 0.04em;">
      <i class="fas fa-shield-halved text-warning me-2"></i>
      GOVERNMENT DISPOSAL CLEARANCE LOT • ALL SEIZED ASSETS 100% VERIFIED & INSPECTED • FREE EXPRESS COURIER
    </div>

    <!-- E-Commerce Hero Section -->
    <section class="ecom-hero-section py-5 position-relative overflow-hidden" style="background: radial-gradient(circle at 80% 20%, rgba(2, 132, 199, 0.15) 0%, transparent 50%), linear-gradient(180deg, #0b1120 0%, #0f172a 100%); color: #ffffff;">
      <div class="container py-4">
        <div class="row align-items-center g-5">
          <div class="col-lg-7">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(2, 132, 199, 0.2); border: 1px solid rgba(56, 189, 248, 0.3);">
              <i class="fas fa-certificate text-warning"></i>
              <span class="small fw-bold text-info text-uppercase" style="letter-spacing: 0.05em;">Direct Citizen Access • No Auction Bidding</span>
            </div>

            <h1 class="display-4 fw-extrabold mb-3 text-white" style="letter-spacing: -0.03em; font-weight: 800; line-height: 1.15;">
              Legally Seized Electronics.<br>
              <span style="background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Fixed Clearance Prices.</span>
            </h1>

            <p class="lead text-white-50 mb-4" style="max-width: 580px; font-size: 1.15rem;">
              Direct public resale of authentic goods confiscated during customs checks, tax operations, and court asset liquidations. Inspected, certified, and backed by escrow.
            </p>

            <!-- Search Bar in Hero -->
            <form action="/customer/search" method="POST" class="mb-4" style="max-width: 580px;">
              <div class="p-2 rounded-pill bg-white shadow-lg d-flex align-items-center gap-2">
                <i class="fas fa-search text-muted ms-3 fs-5"></i>
                <input type="text" name="searchTerm" class="form-control border-0 shadow-none ps-2" 
                       placeholder="Search seized MacBooks, iPhones, cameras, consoles..." style="font-size: 0.95rem;">
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold text-nowrap">
                  Find Deals
                </button>
              </div>
            </form>

            <!-- Popular Quick Filter Tags -->
            <div class="d-flex align-items-center gap-2 flex-wrap text-white-50 small">
              <span class="fw-semibold text-white">Popular:</span>
              <a href="/customer/browsing/laptops" class="badge rounded-pill text-decoration-none px-3 py-2" style="background: rgba(255,255,255,0.1); color:#e2e8f0;">💻 MacBooks</a>
              <a href="/customer/browsing/mobile" class="badge rounded-pill text-decoration-none px-3 py-2" style="background: rgba(255,255,255,0.1); color:#e2e8f0;">📱 iPhones</a>
              <a href="/customer/browsing/electronics" class="badge rounded-pill text-decoration-none px-3 py-2" style="background: rgba(255,255,255,0.1); color:#e2e8f0;">🎧 Sony XM5</a>
              <a href="/customer/browsing/cameras" class="badge rounded-pill text-decoration-none px-3 py-2" style="background: rgba(255,255,255,0.1); color:#e2e8f0;">📷 Canon R5</a>
            </div>
          </div>

          <!-- Hero Spotlight Deal Card -->
          <div class="col-lg-5">
            <div class="card border-0 rounded-4 overflow-hidden shadow-lg" style="background: rgba(255, 255, 255, 0.07); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.15) !important;">
              <div class="p-3 text-center position-relative" style="background: rgba(0,0,0,0.25);">
                <span class="badge bg-danger rounded-pill px-3 py-1 position-absolute top-0 start-0 m-3 shadow">
                  <i class="fas fa-fire me-1"></i> TOP SEIZED DEAL
                </span>
                <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&auto=format&fit=crop&q=80" 
                     alt="Apple MacBook Pro 16 M2 Pro" 
                     class="img-fluid rounded-3 my-2" 
                     style="max-height: 220px; object-fit: cover;">
              </div>
              <div class="p-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-info fw-bold small text-uppercase">Customs Seizure Lot</span>
                  <div class="text-warning small">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                    <span class="text-white-50 ms-1">(4.9)</span>
                  </div>
                </div>
                <h4 class="fw-bold text-white mb-2">Apple MacBook Pro 16" M2 Pro (16GB / 512GB)</h4>
                <div class="d-flex align-items-baseline gap-3 mb-3">
                  <span class="h3 fw-bold text-white mb-0">₹84,999</span>
                  <span class="text-white-50 text-decoration-line-through">₹1,69,900</span>
                  <span class="badge bg-success rounded-pill px-2 py-1">Save 50%</span>
                </div>
                <div class="d-grid gap-2">
                  <a href="/customer/browsing" class="btn btn-primary rounded-pill py-2 fw-bold">
                    <i class="fas fa-shopping-cart me-2"></i> Browse All Seized Stock
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Carousel Bar -->
    <section class="py-4 bg-white border-bottom shadow-sm">
      <div class="container">
        <div class="row g-3 text-center justify-content-center">
          <div class="col-6 col-md-3 col-lg-2">
            <a href="/customer/browsing/laptops" class="text-decoration-none text-dark p-3 rounded-4 d-block border hover-shadow" style="transition: all 0.2s; background: #f8fafc;">
              <div class="fs-2 mb-1 text-primary"><i class="fas fa-laptop"></i></div>
              <div class="fw-bold small">Laptops & PCs</div>
              <small class="text-muted">From ₹64,999</small>
            </a>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <a href="/customer/browsing/mobile" class="text-decoration-none text-dark p-3 rounded-4 d-block border hover-shadow" style="transition: all 0.2s; background: #f8fafc;">
              <div class="fs-2 mb-1 text-primary"><i class="fas fa-mobile-alt"></i></div>
              <div class="fw-bold small">Smartphones</div>
              <small class="text-muted">From ₹59,999</small>
            </a>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <a href="/customer/browsing/electronics" class="text-decoration-none text-dark p-3 rounded-4 d-block border hover-shadow" style="transition: all 0.2s; background: #f8fafc;">
              <div class="fs-2 mb-1 text-primary"><i class="fas fa-headphones"></i></div>
              <div class="fw-bold small">Audio & Tech</div>
              <small class="text-muted">From ₹11,499</small>
            </a>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <a href="/customer/browsing/cameras" class="text-decoration-none text-dark p-3 rounded-4 d-block border hover-shadow" style="transition: all 0.2s; background: #f8fafc;">
              <div class="fs-2 mb-1 text-primary"><i class="fas fa-camera"></i></div>
              <div class="fw-bold small">Cameras & Lenses</div>
              <small class="text-muted">From ₹54,999</small>
            </a>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <a href="/customer/browsing" class="text-decoration-none text-dark p-3 rounded-4 d-block border hover-shadow" style="transition: all 0.2s; background: #f8fafc;">
              <div class="fs-2 mb-1 text-primary"><i class="fas fa-gamepad"></i></div>
              <div class="fw-bold small">Gaming Gear</div>
              <small class="text-muted">From ₹29,999</small>
            </a>
          </div>
          <div class="col-6 col-md-3 col-lg-2">
            <a href="/customer/browsing" class="text-decoration-none text-dark p-3 rounded-4 d-block border hover-shadow" style="transition: all 0.2s; background: #f8fafc;">
              <div class="fs-2 mb-1 text-primary"><i class="fas fa-store"></i></div>
              <div class="fw-bold small">All Categories</div>
              <small class="text-primary fw-bold">Explore All &rarr;</small>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Live Seized Products Showcase -->
    <section class="py-5" style="background: #f8fafc;">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
          <div>
            <span class="badge bg-primary px-3 py-1 rounded-pill mb-2 fw-bold text-uppercase">
              <i class="fas fa-bolt text-warning me-1"></i> Authentic Confiscations
            </span>
            <h2 class="h2 fw-bold text-dark mb-1">Today's Verified Seized Deals</h2>
            <p class="text-muted mb-0">Inspected by accredited disposal agencies. Verified chain of custody.</p>
          </div>
          <a href="/customer/browsing" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
            View All <%= (typeof products !== 'undefined' && products) ? products.length : 12 %> Products <i class="fas fa-arrow-right ms-1"></i>
          </a>
        </div>

        <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
          <div class="row g-4">
            <% products.forEach(function(product) { %>
              <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="product-card h-100 shadow-sm border-0">
                  <div class="product-image-container">
                    <a href="/customer/product/<%= product._id %>" style="display:block; height:100%;">
                      <img src="<%= product.image || '/images/placeholder.png' %>" 
                           alt="<%= product.name %>" 
                           class="product-image" 
                           onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=Seized+Product';">
                    </a>
                    <span class="seizure-badge">
                      <i class="fas fa-gavel me-1"></i> Seized Asset
                    </span>
                    <span class="product-discount-tag"><%= product.condition || 'Verified' %></span>
                  </div>
                  <div class="product-content p-3 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="product-category fw-bold small text-primary text-uppercase">
                        <%= product.category ? (product.category.charAt(0).toUpperCase() + product.category.slice(1)) : 'Electronics' %>
                      </span>
                      <button class="btn btn-sm btn-icon add-to-wishlist border-0 bg-transparent text-muted" title="Save to Wishlist">
                        <i class="far fa-heart"></i>
                      </button>
                    </div>

                    <h3 class="product-title h6 fw-bold mb-1">
                      <a href="/customer/product/<%= product._id %>" class="text-dark text-decoration-none">
                        <%= product.name %>
                      </a>
                    </h3>

                    <small class="text-muted d-block mb-3">
                      <i class="fas fa-landmark me-1 text-secondary"></i>
                      <%= product.agency && product.agency.name ? product.agency.name : 'Customs Disposal Authority' %>
                    </small>

                    <div class="mt-auto pt-2 border-top">
                      <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <div class="product-price h5 fw-bold text-primary mb-0">
                          ₹<%= typeof product.price === 'number' ? product.price.toLocaleString('en-IN') : product.price %>
                        </div>
                        <span class="badge bg-light text-success border small">
                          <i class="fas fa-check-circle me-1"></i> Available
                        </span>
                      </div>

                      <div class="d-flex gap-2">
                        <button class="btn btn-primary add-to-cart add-to-cart-btn flex-grow-1 rounded-pill fw-semibold py-2"
                          data-id="<%= product._id %>"
                          data-name="<%= product.name %>"
                          data-price="<%= product.price %>"
                          data-image="<%= product.image %>">
                          <i class="fas fa-shopping-cart me-1"></i> Add to Cart
                        </button>
                        <a href="/customer/product/<%= product._id %>" class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="View Details">
                          <i class="fas fa-eye"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- How SETU Works Timeline -->
    <section class="py-5 bg-white border-top border-bottom">
      <div class="container py-3">
        <div class="text-center mb-5" style="max-width: 640px; margin: 0 auto;">
          <span class="badge bg-primary px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Transparency Process</span>
          <h2 class="h2 fw-bold text-dark">How Seized Goods Reach Citizens</h2>
          <p class="text-muted">A government-compliant bridge ensuring transparency, fair fixed prices, and absolute trust.</p>
        </div>

        <div class="row g-4 text-center">
          <div class="col-md-4">
            <div class="p-4 rounded-4 bg-light border h-100">
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-gavel"></i>
              </div>
              <h5 class="fw-bold mb-2">1. Official Confiscation</h5>
              <p class="text-muted small mb-0">High-value electronics confiscated during airport customs checks, tax raids, and bankruptcy asset recovery.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-4 rounded-4 bg-light border h-100">
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-clipboard-check"></i>
              </div>
              <h5 class="fw-bold mb-2">2. Verification & Testing</h5>
              <p class="text-muted small mb-0">Disposal authorities inspect hardware, check serial numbers against police records, and issue disposal clearance certificates.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-4 rounded-4 bg-light border h-100">
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-shield-alt"></i>
              </div>
              <h5 class="fw-bold mb-2">3. Escrow Protected Resale</h5>
              <p class="text-muted small mb-0">Citizens buy items directly without auction markups. Funds remain in escrow until you inspect your item upon delivery.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Portals Access Section -->
    <section class="py-5" style="background: #f1f5f9;">
      <div class="container">
        <div class="text-center mb-4">
          <h2 class="h3 fw-bold text-dark">Platform Portals & Account Access</h2>
        </div>
        <div class="row g-4 justify-content-center">
          <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
              <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.4rem; background: #e0f2fe;">
                <i class="fas fa-user-circle"></i>
              </div>
              <h4 class="fw-bold mb-2">Citizen & Buyer Portal</h4>
              <p class="text-muted small mb-4">Browse seized inventory, track orders, manage deliveries, and submit inspection reviews.</p>
              <div class="d-flex gap-2 justify-content-center">
                <a href="/auth/customer/login" class="btn btn-primary rounded-pill px-4 fw-semibold">Sign In</a>
                <a href="/customer/register" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Create Account</a>
              </div>
            </div>
          </div>

          <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
              <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.4rem; background: #e0f2fe;">
                <i class="fas fa-landmark"></i>
              </div>
              <h4 class="fw-bold mb-2">Government Agency Portal</h4>
              <p class="text-muted small mb-4">Upload disposal manifests, manage seized inventory batches, and review fulfillment metrics.</p>
              <div class="d-flex gap-2 justify-content-center">
                <a href="/auth/agency/login" class="btn btn-dark rounded-pill px-4 fw-semibold">Agency Sign In</a>
                <a href="/agency/register" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Register Agency</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Customer Login Page -->
  <% if(page === 'customer-login') { %>
    <div class="auth-shell">
      <div class="auth-visual">
        <span class="auth-badge"><i class="fas fa-shopping-basket"></i> Customer Portal</span>
        <h1>Welcome back to SETU.</h1>
        <p>Discover curated products, track orders, and manage your account from one seamless shopping experience.</p>
        <ul class="auth-features">
          <li><i class="fas fa-check-circle"></i> Personalized recommendations</li>
          <li><i class="fas fa-check-circle"></i> Fast order tracking</li>
          <li><i class="fas fa-check-circle"></i> Secure shopping experience</li>
        </ul>
      </div>

      <div class="auth-panel">
        <div class="auth-panel-header">
          <a href="/" class="auth-logo-mark">
            <span class="logo-icon"><i class="fas fa-shopping-bag"></i></span>
            <span>SETU</span>
          </a>
        </div>

        <div class="auth-form-header">
          <h2>Customer Login</h2>
          <p>Welcome back! Please enter your details.</p>
        </div>

        <form action="/auth/customer/login" method="POST" class="auth-form">
          <div class="form-group">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="Enter your email" required>
          </div>

          <div class="form-group">
            <div class="auth-inline-row" style="align-items:end;">
              <label for="password">Password</label>
              <a href="/auth/customer/forgot-password" class="form-link" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em;">Forgot password?</a>
            </div>
            <input id="password" name="password" type="password" placeholder="Enter your password" required>
          </div>

          <label class="auth-remember" for="remember">
            <input type="checkbox" id="remember" name="remember">
            <span>Remember me for 30 days</span>
          </label>

          <button type="submit" class="btn btn-primary">Sign in</button>

          <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill w-100 mt-2" onclick="document.getElementById('email').value='customer@example.com'; document.getElementById('password').value='password123';">
            <i class="fas fa-magic me-1"></i> Fill Demo Customer Credentials
          </button>
        </form>

        <div class="auth-footer">
          <p>Don't have an account? <a href="/auth/customer/register">Sign up</a></p>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Customer Register Page -->
  <% if(page === 'customer-register') { %>
    <div class="auth-shell">
      <div class="auth-visual">
        <span class="auth-badge"><i class="fas fa-user-plus"></i> New Customer</span>
        <h1>Start shopping with SETU.</h1>
        <p>Join today to save favorites, track orders, and explore premium products from trusted sellers.</p>
        <ul class="auth-features">
          <li><i class="fas fa-check-circle"></i> One-click checkout</li>
          <li><i class="fas fa-check-circle"></i> Exclusive deals</li>
          <li><i class="fas fa-check-circle"></i> Secure account management</li>
        </ul>
      </div>

      <div class="auth-panel">
        <div class="auth-panel-header">
          <a href="/" class="auth-logo-mark">
            <span class="logo-icon"><i class="fas fa-shopping-bag"></i></span>
            <span>SETU</span>
          </a>
        </div>

        <div class="auth-form-header">
          <h2>Create Account</h2>
          <p>Fill in your details to get started.</p>
        </div>

        <form action="/auth/customer/register" method="POST" class="auth-form">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input id="name" name="name" type="text" placeholder="Enter your full name" required value="<%= typeof name != 'undefined' ? name : '' %>">
