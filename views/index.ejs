                <span class="text-muted small">
                  <i class="fas fa-box text-primary me-1"></i> Stock Available: <strong><%= product.stock || 1 %></strong>
                </span>
              </div>

              <div class="d-flex gap-3">
                <button class="btn btn-primary add-to-cart add-to-cart-btn rounded-pill px-4 py-3 fw-bold flex-grow-1 shadow-sm"
                  data-id="<%= product._id %>"
                  data-name="<%= product.name %>"
                  data-price="<%= product.price %>"
                  data-image="<%= product.image %>">
                  <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                </button>
                <a href="/customer/checkout" class="btn btn-dark rounded-pill px-4 py-3 fw-bold add-to-cart add-to-cart-btn"
                  data-id="<%= product._id %>"
                  data-name="<%= product.name %>"
                  data-price="<%= product.price %>"
                  data-image="<%= product.image %>">
                  <i class="fas fa-bolt me-2 text-warning"></i> Buy Now
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Customer Cart Page -->
  <% if(page === 'customer-cart') { %>
    <div class="container cart-page-wrapper">
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
          <h1 class="h2 fw-bold mb-1"><i class="fas fa-shopping-bag text-primary me-2"></i> Shopping Cart</h1>
          <p class="text-muted mb-0">Review your selected seized items and proceed to secure checkout</p>
        </div>
        <a href="/customer/browsing" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold">
          <i class="fas fa-arrow-left me-1"></i> Continue Shopping
        </a>
      </div>

      <% if (typeof cart !== 'undefined' && cart && cart.length > 0) { %>
        <div class="row g-4">
          <!-- Items List Column -->
          <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
              <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0">Cart Items (<%= cart.length %>)</h5>
              </div>
              <div class="card-body p-4">
                <div class="cart-items" id="cartItems">
                  <% cart.forEach(item => { %>
                    <div class="cart-item-row" data-product-id="<%= item.productId %>" data-price="<%= item.price %>">
                      <img src="<%= item.image || '/images/placeholder.png' %>" 
                           alt="<%= item.name %>" 
                           class="cart-item-thumb" 
                           onerror="this.onerror=null; this.src='https://via.placeholder.com/80x80?text=Item';">
                      
                      <div class="flex-grow-1">
                        <h6 class="fw-bold text-dark mb-1"><%= item.name %></h6>
                        <small class="text-muted d-block mb-1">Verified Seized Asset</small>
                        <div class="text-primary fw-semibold">
                          ₹<%= (item.price || 0).toLocaleString('en-IN') %> per unit
                        </div>
                      </div>

                      <!-- Quantity Stepper -->
                      <div class="cart-qty-ctrl">
                        <button type="button" class="cart-qty-btn cart-qty-minus">-</button>
                        <input type="text" class="cart-qty-input" value="<%= item.quantity %>" readonly>
                        <button type="button" class="cart-qty-btn cart-qty-plus">+</button>
                      </div>

                      <!-- Subtotal for item -->
                      <div class="fw-bold text-dark fs-6 cart-item-subtotal text-end" style="min-width: 90px;">
                        ₹<%= ((item.price || 0) * (item.quantity || 1)).toLocaleString('en-IN') %>
                      </div>

                      <!-- Remove Button -->
                      <button type="button" class="cart-item-remove-btn" title="Remove item">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>

            <!-- Escrow Notice -->
            <div class="p-3 bg-light rounded-4 border mt-3 d-flex align-items-center gap-3">
              <i class="fas fa-shield-halved text-success fa-2x"></i>
              <div>
                <strong class="d-block text-dark">Protected by SETU Escrow</strong>
                <small class="text-muted">Your funds are safe. Payment is only released to the agency after your 7-day inspection window.</small>
              </div>
            </div>
          </div>

          <!-- Order Summary Column -->
          <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden sticky-top" style="top: 5.5rem;">
              <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold mb-0">Order Summary</h5>
              </div>
              <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Subtotal</span>
                  <span class="fw-bold text-dark" id="cartSubtotal">₹<%= (subtotal || 0).toLocaleString('en-IN') %></span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Estimated GST (10%)</span>
                  <span class="fw-bold text-dark" id="cartTax">₹<%= (tax || 0).toFixed(2) %></span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                  <span class="text-muted">Delivery Charges</span>
                  <span class="text-success fw-bold" id="cartShipping">₹5.00</span>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                  <span class="h6 fw-bold mb-0">Total Amount</span>
                  <span class="h4 fw-bold text-primary mb-0" id="cartTotal">₹<%= Math.round(total || 0).toLocaleString('en-IN') %></span>
                </div>

                <a href="/customer/checkout" class="btn btn-primary rounded-pill w-100 py-3 fw-bold fs-6 shadow-sm d-flex align-items-center justify-content-center gap-2" id="checkoutBtn">
                  <span>Proceed to Checkout</span>
                  <i class="fas fa-arrow-right"></i>
                </a>

                <div class="mt-4 pt-3 border-top">
                  <div class="input-group">
                    <input type="text" class="form-control rounded-start-pill ps-3" placeholder="Promo code (e.g. SETU10)" id="promoInput">
                    <button class="btn btn-outline-secondary rounded-end-pill px-3" type="button" onclick="showToast('Promo code SETU10 applied! 10% discount', 'success')">Apply</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
          <div class="text-primary mb-3 opacity-50">
            <i class="fas fa-shopping-cart fa-4x"></i>
          </div>
          <h3 class="fw-bold mb-2">Your Shopping Cart is Empty</h3>
          <p class="text-muted mb-4">You haven't added any seized electronic items to your cart yet.</p>
          <div>
            <a href="/customer/browsing" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold shadow-sm">
              <i class="fas fa-store me-2"></i> Explore Seized Catalog
            </a>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Customer Checkout Page -->
  <% if(page === 'customer-checkout') { %>
    <div class="container">
      <!-- Mobile Sidebar Toggle -->
      <button class="mobile-sidebar-toggle" id="sidebarToggle">
        <i class="fas fa-bars"></i>
      </button>

      <!-- Mobile Header -->
      <div class="mobile-header">
        <div class="mobile-header-content">
          <a href="/customer/browsing" class="mobile-logo">SETU</a>
        </div>
      </div>

      <!-- Sidebar -->
      <%- include('partials/sidebar') %>

      <!-- Main Content -->
      <main class="main-content">
        <div class="page-header">
          <h1 class="page-title">Checkout</h1>
          <p class="page-description">Complete your purchase</p>
        </div>

        <form action="/customer/place-order" method="POST">
          <div class="flex-wrap">
            <div class="flex-1 min-w-300">
              <div class="card">
                <div class="card-header">
                  <h2 class="card-title">Shipping Information</h2>
                  <p class="card-description">Enter your shipping details</p>
                </div>
                <div class="card-content">
                  <div class="form-row">
                    <div class="form-group">
                      <label for="firstName" class="form-label">First Name</label>
                      <input type="text" id="firstName" name="firstName" class="form-input" required>
                    </div>
                    <div class="form-group">
                      <label for="lastName" class="form-label">Last Name</label>
                      <input type="text" id="lastName" name="lastName" class="form-input" required>
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label for="email" class="form-label">Email</label>
                      <input type="email" id="email" name="email" class="form-input" required>
                    </div>
                    <div class="form-group">
                      <label for="phone" class="form-label">Phone</label>
                      <input type="tel" id="phone" name="phone" class="form-input" required>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="address" class="form-label">Address</label>
                    <input type="text" id="address" name="address" class="form-input" required>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label for="city" class="form-label">City</label>
                      <input type="text" id="city" name="city" class="form-input" required>
                    </div>
                    <div class="form-group">
                      <label for="state" class="form-label">State</label>
                      <input type="text" id="state" name="state" class="form-input" required>
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label for="zip" class="form-label">ZIP Code</label>
                      <input type="text" id="zip" name="zip" class="form-input" required>
                    </div>
                    <div class="form-group">
                      <label for="country" class="form-label">Country</label>
                      <input type="text" id="country" name="country" class="form-input" required>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card">
                <div class="card-header">
                  <h2 class="card-title">Payment Method</h2>
                  <p class="card-description">Select your preferred payment method</p>
                </div>
                <div class="card-content">
                  <div class="payment-methods">
                    <div class="payment-method-tabs">
                      <div class="payment-method-tab active" data-method="credit-card">
                        <i class="far fa-credit-card"></i> Credit Card
                      </div>
                      <div class="payment-method-tab" data-method="paypal">
                        <i class="fab fa-paypal"></i> PayPal
                      </div>
                      <div class="payment-method-tab" data-method="apple-pay">
                        <i class="fab fa-apple-pay"></i> Apple Pay
                      </div>
                      <div class="payment-method-tab" data-method="paytm">
                        <i class="fas fa-wallet"></i> Paytm
                      </div>
                    </div>

                    <div class="payment-method-content active" id="credit-card-content">
                      <div class="credit-card-info">
                        <div class="form-group">
                          <label for="cardNumber" class="form-label">Card Number</label>
                          <input type="text" id="cardNumber" name="cardNumber" class="form-input" placeholder="Enter your card number">
                        </div>
                        <div class="form-group">
                          <label for="cardName" class="form-label">Name on Card</label>
                          <input type="text" id="cardName" name="cardName" class="form-input" placeholder="Enter the name on the card">
                        </div>
                        <div class="form-row">
                          <div class="form-group">
                            <label for="cardExpiry" class="form-label">Expiration Date</label>
                            <input type="text" id="cardExpiry" name="cardExpiry" class="form-input" placeholder="MM/YY">
                          </div>
                          <div class="form-group">
                            <label for="cardCvv" class="form-label">CVV</label>
                            <input type="text" id="cardCvv" name="cardCvv" class="form-input" placeholder="CVV">
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="payment-method-content" id="paypal-content">
                      <div class="paypal-info">
                        <p>You will be redirected to PayPal to complete your payment securely.</p>
                        <button type="button" class="btn btn-primary mt-4">Pay with PayPal</button>
                      </div>
                    </div>

                    <div class="payment-method-content" id="apple-pay-content">
                      <div class="apple-pay-info">
                        <p>Pay securely with Apple Pay.</p>
                        <button type="button" class="btn btn-primary mt-4">
                          <i class="fab fa-apple-pay"></i> Pay with Apple Pay
                        </button>
                      </div>
                    </div>

                    <div class="payment-method-content" id="paytm-content">
                      <div class="paytm-info">
                        <p>You will be redirected to Paytm to complete your payment securely.</p>
                        <div class="paytm-logo">
                          <div class="paytm-logo-image">
                            <i class="fas fa-wallet fa-2x"></i> <span class="paytm-text">Paytm</span>
                          </div>
                        </div>
                        <div class="paytm-form">
                          <div class="form-group">
                            <label for="paytmMobile" class="form-label">Mobile Number</label>
                            <input type="tel" id="paytmMobile" name="paytmMobile" class="form-input" placeholder="Enter your registered mobile number" maxlength="10">
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <input type="hidden" name="paymentMethod" id="paymentMethod" value="credit-card">
                </div>
              </div>
            </div>

            <div class="cart-sidebar">
              <div class="card cart-summary">
                <div class="card-header">
                  <h2 class="card-title">Order Summary</h2>
                </div>
                <div class="card-content">
                  <div class="checkout-items">
                    <% if(cart && cart.length > 0) { %>
                      <% cart.forEach(function(item) { %>
                        <div class="checkout-item">
                          <div class="checkout-item-image">
                            <img src="<%= item.image %>" alt="<%= item.name %>">
                          </div>
                          <div class="checkout-item-details">
                            <div class="checkout-item-name"><%= item.name %></div>
                            <div class="checkout-item-price">
                              $<%= item.price.toFixed(2) %> × <%= item.quantity %>
                            </div>
                          </div>
                        </div>
                      <% }); %>
                    <% } %>
                  </div>

                  <div class="cart-subtotal">
                    <span>Subtotal</span>
                    <span class="cart-subtotal-value">$<%= subtotal.toFixed(2) %></span>
                  </div>

                  <div class="cart-tax">
                    <span>Tax (10%)</span>
                    <span class="cart-tax-value">$<%= tax.toFixed(2) %></span>
                  </div>

                  <div class="cart-shipping">
                    <span>Shipping</span>
                    <span class="cart-shipping-value">$<%= shipping.toFixed(2) %></span>
                  </div>

                  <div class="cart-total">
                    <span>Total</span>
                    <span class="cart-total-value">$<%= total.toFixed(2) %></span>
                  </div>

                  <button type="submit" class="btn btn-primary btn-block">Place Order</button>
                </div>
              </div>

              <div class="card mt-4">
                <div class="card-header">
                  <h3 class="card-title">Secure Checkout</h3>
                </div>
                <div class="card-content">
                  <p class="secure-text">All your information is secured by 256-bit SSL encryption.</p>
                  <div class="payment-icons">
                    <i class="fab fa-cc-visa"></i>
                    <i class="fab fa-cc-mastercard"></i>
                    <i class="fab fa-cc-amex"></i>
                    <i class="fab fa-cc-discover"></i>
                    <i class="fab fa-cc-paypal"></i>
                    <i class="fab fa-apple-pay"></i>
                    <i class="fas fa-wallet paytm-icon"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </main>
    </div>
  <% } %>

