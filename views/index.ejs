  <!-- Customer Browsing Page -->
  <% if(page === 'customer-browsing') { %>
    <!-- Catalog Hero Banner -->
    <section class="py-4 border-bottom position-relative" style="background: linear-gradient(135deg, #0b1120 0%, #0f172a 50%, #0369a1 100%); color: #ffffff;">
      <div class="container py-2" style="max-width: 1320px;">
        <div class="row align-items-center g-3">
          <div class="col-lg-7">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(2, 132, 199, 0.25); border: 1px solid rgba(56, 189, 248, 0.35);">
              <i class="fas fa-gavel text-warning"></i>
              <span class="small fw-bold text-info text-uppercase" style="letter-spacing: 0.05em;">Direct Citizen Disposal Catalog</span>
            </div>
            <h1 class="h2 fw-extrabold text-white mb-2" style="font-weight: 800; letter-spacing: -0.02em;">
              Government Seized & Confiscated Assets
            </h1>
            <p class="text-white-50 mb-0 small" style="max-width: 580px;">
              Direct procurement of verified confiscations from Customs, Enforcement Directorate, and Police clearances. Inspected serial numbers, fixed clearance pricing, and 100% escrow protection.
            </p>
          </div>
          <div class="col-lg-5">
            <form action="/customer/search" method="POST" class="d-flex shadow-sm rounded-pill p-1 bg-white">
              <input type="text" name="searchTerm" placeholder="Search laptops, phones, cameras..." 
                     class="form-control border-0 rounded-pill ps-3 shadow-none" 
                     value="<%= locals.searchTerm || '' %>" required>
              <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                <i class="fas fa-search me-1"></i> Search
              </button>
            </form>
            <div class="d-flex gap-3 justify-content-end mt-2 text-white-50 small">
              <span><i class="fas fa-shield-alt text-success me-1"></i> Escrow Secured</span>
              <span><i class="fas fa-check-circle text-info me-1"></i> 100% Authentic</span>
              <span><i class="fas fa-truck text-warning me-1"></i> Fast Shipping</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Catalog Content -->
    <div class="container py-4" style="max-width: 1320px;">
      <!-- Breadcrumb & Stats Bar -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0 bg-transparent p-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fas fa-home me-1"></i> Home</a></li>
            <li class="breadcrumb-item"><a href="/customer/browsing" class="text-decoration-none text-muted">Catalog</a></li>
            <li class="breadcrumb-item active text-dark fw-bold text-capitalize" aria-current="page">
              <%= (typeof activeTab !== 'undefined' && activeTab !== 'all') ? activeTab : 'All Products' %>
            </li>
          </ol>
        </nav>
        <div class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold shadow-xs">
          <i class="fas fa-box text-primary me-1"></i> Showing <%= (typeof products !== 'undefined' && products) ? products.length : 0 %> Seized Assets
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
        <a href="/customer/browsing" 
           class="btn rounded-pill px-4 py-2 fw-semibold <%= (activeTab === 'all' || !activeTab) ? 'btn-primary shadow-sm' : 'btn-outline-secondary' %>">
          <i class="fas fa-th-large me-1"></i> All Items
        </a>
        <a href="/customer/browsing/laptops" 
           class="btn rounded-pill px-4 py-2 fw-semibold <%= activeTab === 'laptops' ? 'btn-primary shadow-sm' : 'btn-outline-secondary' %>">
          <i class="fas fa-laptop me-1"></i> Laptops & Computers
        </a>
        <a href="/customer/browsing/mobile" 
           class="btn rounded-pill px-4 py-2 fw-semibold <%= activeTab === 'mobile' ? 'btn-primary shadow-sm' : 'btn-outline-secondary' %>">
          <i class="fas fa-mobile-alt me-1"></i> Smartphones
        </a>
        <a href="/customer/browsing/cameras" 
           class="btn rounded-pill px-4 py-2 fw-semibold <%= activeTab === 'cameras' ? 'btn-primary shadow-sm' : 'btn-outline-secondary' %>">
          <i class="fas fa-camera me-1"></i> Cameras & Drones
        </a>
        <a href="/customer/browsing/electronics" 
           class="btn rounded-pill px-4 py-2 fw-semibold <%= activeTab === 'electronics' ? 'btn-primary shadow-sm' : 'btn-outline-secondary' %>">
          <i class="fas fa-headphones me-1"></i> Audio & Electronics
        </a>
      </div>

      <!-- Product Cards Grid -->
      <% if(typeof products !== 'undefined' && products && products.length > 0) { %>
        <div class="row g-4">
          <% products.forEach(function(product) { %>
            <div class="col-xl-3 col-lg-4 col-md-6">
              <div class="product-card h-100 shadow-sm border-0 d-flex flex-column" style="border-radius: 18px; overflow: hidden; background: #ffffff; transition: transform 0.2s, box-shadow 0.2s;">
                <div class="product-image-container position-relative overflow-hidden" style="height: 200px; background: #f8fafc;">
                  <a href="/customer/product/<%= product._id %>" style="display:block; height:100%;">
                    <img src="<%= product.image || '/images/placeholder.png' %>" 
                         alt="<%= product.name %>" 
                         class="product-image w-100 h-100" 
                         style="object-fit: cover; transition: transform 0.35s ease;"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=Seized+Product';">
                  </a>
                  <span class="position-absolute top-0 start-0 m-2 badge bg-dark text-warning rounded-pill px-2 py-1 shadow-sm small">
                    <i class="fas fa-gavel me-1"></i> Seized Asset
                  </span>
                  <span class="position-absolute top-0 end-0 m-2 badge bg-primary text-white rounded-pill px-2 py-1 shadow-sm small">
                    <%= product.condition || 'Verified' %>
                  </span>
                </div>

                <div class="p-3 d-flex flex-column flex-grow-1">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="product-category fw-bold small text-primary text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                      <%= product.category ? (product.category.charAt(0).toUpperCase() + product.category.slice(1)) : 'Electronics' %>
                    </span>
                    <button class="btn btn-sm btn-icon add-to-wishlist border-0 bg-transparent text-muted" title="Save to Wishlist">
                      <i class="far fa-heart"></i>
                    </button>
                  </div>

                  <h3 class="h6 fw-bold mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                    <a href="/customer/product/<%= product._id %>" class="text-dark text-decoration-none">
                      <%= product.name %>
                    </a>
                  </h3>

                  <small class="text-muted d-block mb-3" style="font-size: 0.78rem;">
                    <i class="fas fa-landmark me-1 text-secondary"></i>
                    <%= product.agency && product.agency.name ? product.agency.name : 'Customs Disposal Authority' %>
                  </small>

                  <div class="mt-auto pt-2 border-top">
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                      <div class="h5 fw-bold text-primary mb-0">
                        ₹<%= typeof product.price === 'number' ? product.price.toLocaleString('en-IN') : product.price %>
                      </div>
                      <span class="badge bg-light text-success border small">
                        <i class="fas fa-check-circle me-1"></i> In Stock (<%= product.stock || 1 %>)
                      </span>
                    </div>

                    <div class="d-flex gap-2">
                      <button class="btn btn-primary add-to-cart add-to-cart-btn flex-grow-1 rounded-pill fw-semibold py-2"
                        data-id="<%= product._id %>"
                        data-name="<%= product.name %>"
                        data-price="<%= product.price %>"
                        data-image="<%= product.image %>">
                        <i class="fas fa-shopping-cart me-1"></i> Add to Cart
                      </button>
                      <a href="/customer/product/<%= product._id %>" class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="View Details">
                        <i class="fas fa-eye"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-5 text-center bg-white rounded-4 border p-5 shadow-sm my-4">
          <div class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
            <i class="fas fa-box-open"></i>
          </div>
          <h4 class="fw-bold mb-1">No Seized Products Found</h4>
          <p class="text-muted mb-4" style="max-width: 440px; margin: 0 auto;">
            No confiscated inventory matches your selection right now. More seized lots are cleared every week.
          </p>
          <a href="/customer/browsing" class="btn btn-primary rounded-pill px-4 fw-semibold">
            <i class="fas fa-store me-1"></i> Browse All Confiscations
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Customer Product Details Page -->
  <% if(page === 'customer-product-details' && typeof product !== 'undefined' && product) { %>
    <div class="container my-4" style="max-width: 1200px;">
      <!-- Breadcrumb -->
