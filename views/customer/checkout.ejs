<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure Checkout | SETU Platform</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/ui-enhancements.css">
  <style>
    body {
      background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #0f172a;
      min-height: 100vh;
    }

    .checkout-container {
      max-width: 1200px;
      margin: 2.5rem auto 4rem;
      padding: 0 1.25rem;
    }

    .checkout-card {
      background: #ffffff;
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 20px;
      box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
      margin-bottom: 1.75rem;
      overflow: hidden;
    }

    .checkout-card-header {
      padding: 1.35rem 1.75rem;
      background: #ffffff;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .checkout-card-header h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0;
      color: #0f172a;
    }

    .checkout-card-body {
      padding: 1.75rem;
    }

    .step-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      margin-bottom: 2.5rem;
    }

    .step-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 600;
      font-size: 0.925rem;
      color: #94a3b8;
    }

    .step-item.active {
      color: #0284c7;
    }

    .step-number {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .step-item.active .step-number {
      background: #0284c7;
      color: #ffffff;
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.18);
    }

    .form-control, .form-select {
      border-radius: 12px;
      border: 1.5px solid #e2e8f0;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
      transition: all 0.2s;
    }

    .form-control:focus, .form-select:focus {
      border-color: #0284c7;
      box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.12);
    }

    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: #334155;
      margin-bottom: 0.4rem;
    }

    .payment-option-card {
      border: 1.5px solid #e2e8f0;
      border-radius: 14px;
      padding: 1.1rem 1.25rem;
      margin-bottom: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .payment-option-card:hover {
      border-color: #0284c7;
      background: #f8fafc;
    }

    .payment-option-card.selected {
      border-color: #0284c7;
      background: #f0f9ff;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
    }

    .summary-item {
      display: flex;
      gap: 1rem;
      align-items: center;
      padding: 0.85rem 0;
      border-bottom: 1px solid #f1f5f9;
    }

    .summary-thumb {
      width: 56px;
      height: 56px;
      border-radius: 10px;
      object-fit: cover;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
    }

    .btn-place-order {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      color: white;
      font-weight: 700;
      padding: 1rem;
      border-radius: 14px;
      border: none;
      width: 100%;
      font-size: 1.05rem;
      box-shadow: 0 10px 24px -6px rgba(2, 132, 199, 0.35);
      transition: all 0.25s;
    }

    .btn-place-order:hover {
      background: linear-gradient(135deg, #0369a1 0%, #0c4a6e 100%);
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -4px rgba(2, 132, 199, 0.45);
    }

    .badge-escrow {
      background: #ecfdf5;
      color: #059669;
      border: 1px solid #a7f3d0;
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  </style>
</head>
<body>

  <%- include('../partials/header') %>

  <div class="checkout-container">
    <!-- Progress Indicator -->
    <div class="step-indicator">
      <div class="step-item">
        <span class="step-number"><i class="fas fa-check"></i></span>
        <span>1. Cart</span>
      </div>
      <div class="step-item active">
        <span class="step-number">2</span>
        <span>2. Secure Checkout</span>
      </div>
      <div class="step-item">
        <span class="step-number">3</span>
        <span>3. Confirmation</span>
      </div>
    </div>

    <% 
      const cartItems = Array.isArray(cart) ? cart : ((cart && cart.items) ? cart.items : []);
      const computedSubtotal = typeof subtotal !== 'undefined' ? subtotal : (cartItems.reduce((acc, i) => acc + (i.price * i.quantity), 0));
      const computedTax = typeof tax !== 'undefined' ? tax : (computedSubtotal * 0.1);
      const computedShipping = typeof shipping !== 'undefined' ? shipping : 5;
      const computedTotal = typeof total !== 'undefined' ? total : (computedSubtotal + computedTax + computedShipping);
    %>

    <% if (cartItems.length === 0) { %>
      <div class="checkout-card p-5 text-center my-4">
        <div class="text-primary mb-3 opacity-50">
          <i class="fas fa-shopping-cart fa-4x"></i>
        </div>
        <h3 class="fw-bold mb-2">Your shopping cart is empty</h3>
        <p class="text-muted mb-4">Please add items to your cart before proceeding to checkout.</p>
        <div>
          <a href="/customer/browsing" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
            <i class="fas fa-store me-1"></i> Browse Seized Electronics
          </a>
        </div>
      </div>
    <% } else { %>
      <form action="/customer/place-order" method="POST" id="checkoutForm">
        <div class="row g-4">
          <!-- Left Column: Shipping & Payment -->
          <div class="col-lg-7">
            <!-- Shipping Information -->
            <div class="checkout-card">
              <div class="checkout-card-header">
                <i class="fas fa-map-marker-alt text-primary fa-lg"></i>
                <h3>1. Delivery Address</h3>
              </div>
              <div class="checkout-card-body">
                <div class="row g-3">
                  <div class="col-sm-6">
                    <label class="form-label" for="firstName">First Name</label>
                    <input type="text" class="form-control" id="firstName" name="firstName" 
                           value="<%= user && user.name ? user.name.split(' ')[0] : '' %>" required placeholder="John">
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="lastName">Last Name</label>
                    <input type="text" class="form-control" id="lastName" name="lastName" 
                           value="<%= user && user.name && user.name.split(' ').length > 1 ? user.name.split(' ').slice(1).join(' ') : 'Doe' %>" required placeholder="Doe">
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="email">Email Address</label>
                    <input type="email" class="form-control" id="email" name="email" 
                           value="<%= user && user.email ? user.email : '' %>" required placeholder="name@example.com">
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label" for="phone">Phone Number</label>
                    <input type="tel" class="form-control" id="phone" name="phone" 
                           value="<%= user && user.phone ? user.phone : '9876543210' %>" required placeholder="+91 98765 43210">
                  </div>
                  <div class="col-12">
                    <label class="form-label" for="address">Street Address</label>
                    <input type="text" class="form-control" id="address" name="address" 
                           required placeholder="Building No, Flat No, Street or Area">
                  </div>
                  <div class="col-sm-5">
                    <label class="form-label" for="city">City</label>
                    <input type="text" class="form-control" id="city" name="city" required placeholder="City">
                  </div>
                  <div class="col-sm-4">
                    <label class="form-label" for="state">State</label>
                    <input type="text" class="form-control" id="state" name="state" required placeholder="State">
                  </div>
                  <div class="col-sm-3">
                    <label class="form-label" for="zip">PIN Code</label>
                    <input type="text" class="form-control" id="zip" name="zip" required placeholder="110001">
                  </div>
                  <input type="hidden" name="country" value="India">
                </div>
              </div>
            </div>

            <!-- Payment Method Selection -->
            <div class="checkout-card">
              <div class="checkout-card-header">
                <i class="fas fa-lock text-success fa-lg"></i>
                <h3>2. Secure Payment Method</h3>
              </div>
              <div class="checkout-card-body">
                <div class="badge-escrow mb-3">
                  <i class="fas fa-shield-alt"></i>
                  <span><strong>SETU Escrow Protection:</strong> Funds are safely held in escrow until order delivery is verified.</span>
                </div>

                <div class="payment-option-card selected" onclick="selectPayment('credit-card', this)">
                  <input class="form-check-input mt-0" type="radio" name="paymentMethod" id="payCC" value="credit-card" checked>
                  <div class="flex-grow-1 d-flex justify-content-between align-items-center">
                    <div>
                      <strong class="d-block">Credit / Debit Card</strong>
                      <small class="text-muted">Visa, Mastercard, RuPay, Amex</small>
                    </div>
                    <div class="text-muted">
                      <i class="fab fa-cc-visa fa-2x me-1 text-primary"></i>
                      <i class="fab fa-cc-mastercard fa-2x text-danger"></i>
                    </div>
                  </div>
                </div>

                <div class="payment-option-card" onclick="selectPayment('paytm', this)">
                  <input class="form-check-input mt-0" type="radio" name="paymentMethod" id="payUPI" value="paytm">
                  <div class="flex-grow-1 d-flex justify-content-between align-items-center">
                    <div>
                      <strong class="d-block">UPI & QR Code (Fast)</strong>
                      <small class="text-muted">Google Pay, PhonePe, Paytm, BHIM</small>
                    </div>
                    <span class="badge bg-success rounded-pill px-2 py-1">Instant</span>
                  </div>
                </div>

                <div class="payment-option-card" onclick="selectPayment('Cash on Delivery', this)">
                  <input class="form-check-input mt-0" type="radio" name="paymentMethod" id="payCOD" value="Cash on Delivery">
                  <div class="flex-grow-1">
                    <strong class="d-block">Cash on Delivery (COD) / Inspection on Arrival</strong>
                    <small class="text-muted">Pay after inspecting your legally verified package</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Order Summary -->
          <div class="col-lg-5">
            <div class="checkout-card sticky-top" style="top: 5rem;">
              <div class="checkout-card-header d-flex justify-content-between align-items-center">
                <h3>Order Summary</h3>
                <span class="badge bg-primary rounded-pill"><%= cartItems.length %> Items</span>
              </div>
              <div class="checkout-card-body">
                <div class="order-items-list mb-3" style="max-height: 280px; overflow-y: auto;">
                  <% cartItems.forEach(item => { %>
                    <div class="summary-item">
                      <img src="<%= item.image || '/api/placeholder/100/100' %>" 
                           alt="<%= item.name %>" 
                           class="summary-thumb" 
                           onerror="this.onerror=null; this.src='https://via.placeholder.com/100x100?text=Product';">
                      <div class="flex-grow-1">
                        <div class="fw-bold text-truncate" style="max-width: 190px;"><%= item.name %></div>
                        <small class="text-muted">Qty: <%= item.quantity %></small>
                      </div>
                      <div class="fw-bold text-end">
                        ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Subtotal</span>
                  <span class="fw-semibold">₹<%= computedSubtotal.toLocaleString('en-IN') %></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Estimated GST (10%)</span>
                  <span class="fw-semibold">₹<%= computedTax.toFixed(2) %></span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                  <span class="text-muted">Standard Courier Delivery</span>
                  <span class="text-success fw-bold">₹<%= computedShipping %></span>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                  <span class="h5 fw-bold mb-0">Total Amount</span>
                  <span class="h3 fw-bold text-primary mb-0">₹<%= Math.round(computedTotal).toLocaleString('en-IN') %></span>
                </div>

                <button type="submit" class="btn-place-order" id="submitOrderBtn">
                  <i class="fas fa-lock me-2"></i> Place Secure Order
                </button>

                <div class="text-center mt-3">
                  <small class="text-muted">
                    <i class="fas fa-check-circle text-success me-1"></i> 7-Day Replacement Guarantee & Verified Documentation
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    <% } %>
  </div>

  <%- include('../partials/footer') %>

  <script>
    function selectPayment(val, el) {
      document.querySelectorAll('.payment-option-card').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      const radio = el.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;
    }

    const form = document.getElementById('checkoutForm');
    if (form) {
      form.addEventListener('submit', function() {
        const btn = document.getElementById('submitOrderBtn');
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Confirming Seizure Clearance...';
        }
      });
    }
  </script>
</body>
</html>
