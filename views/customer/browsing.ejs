<!-- Customer Browsing Page -->
<div class="dashboard-container">
  <!-- Sidebar -->
  <%- include('../partials/customer-sidebar') %>

  <!-- Main Content -->
  <div class="main-content">
    <!-- Header Section -->
    <div class="dashboard-header">
      <h1 class="dashboard-title">Browse Products</h1>
    </div>

    <!-- Search Section -->
    <div class="search-container">
      <form action="/customer/search" method="POST" class="search-form">
        <div class="search-input-wrapper">
          <i class="fas fa-search search-icon"></i>
          <input type="text" name="search" class="search-input" placeholder="Search products...">
        </div>
      </form>
    </div>

    <!-- Category Tabs -->
    <div class="category-tabs mb-4">
      <a href="/customer/browsing" class="category-tab <%= (typeof category === 'undefined' || !category || category === 'all') ? 'active' : '' %>">All Items</a>
      <a href="/customer/browsing/electronics" class="category-tab <%= (typeof category !== 'undefined' && category === 'electronics') ? 'active' : '' %>">Electronics</a>
      <a href="/customer/browsing/clothing" class="category-tab <%= (typeof category !== 'undefined' && category === 'clothing') ? 'active' : '' %>">Clothing</a>
      <a href="/customer/browsing/books" class="category-tab <%= (typeof category !== 'undefined' && category === 'books') ? 'active' : '' %>">Books</a>
      <a href="/customer/browsing/home" class="category-tab <%= (typeof category !== 'undefined' && category === 'home') ? 'active' : '' %>">Home & Living</a>
    </div>

    <!-- Product Grid -->
    <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
      <div class="product-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <div class="product-image-container">
              <img src="<%= product.image || '/images/placeholder.png' %>" alt="<%= product.name %>" class="product-image" onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=Product+Image';">
            </div>
            <div class="product-content">
              <div class="product-category"><%= product.category %></div>
              <h3 class="product-title"><%= product.name %></h3>
              <p class="product-description"><%= product.description %></p>
              <div class="product-footer-row">
                <div class="product-price">₹<%= typeof product.price === 'number' ? product.price.toLocaleString('en-IN') : product.price %></div>
              </div>
              <div class="product-actions mt-3">
                <button class="btn btn-primary add-to-cart-btn flex-1" data-product-id="<%= product._id %>">
                  <i class="fas fa-shopping-cart me-1"></i> Add to Cart
                </button>
                <button class="btn btn-icon add-to-wishlist" data-product-id="<%= product._id %>" title="Add to Wishlist">
                  <i class="fas fa-heart"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card p-5 text-center my-4 empty-state-card">
        <div class="empty-state-icon mb-3 text-muted">
          <i class="fas fa-box-open fa-3x"></i>
        </div>
        <h4>No Products Available</h4>
        <p class="text-muted">There are currently no items matching this category. Please check back later or browse all items.</p>
        <div>
          <a href="/customer/browsing" class="btn btn-primary mt-2">
            <i class="fas fa-store me-1"></i> Browse All Products
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- Add to Cart Notification -->
<div class="notification" id="cart-notification">
  Product added to cart successfully!
</div>

<!-- Add to Wishlist Notification -->
<div class="notification" id="wishlist-notification">
  Product added to wishlist successfully!
</div>

<script>
  // Add to Cart functionality
  document.querySelectorAll('.add-to-cart').forEach(button => {
    button.addEventListener('click', async () => {
      const productId = button.dataset.productId;
      try {
        const response = await fetch('/customer/cart/add', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ productId })
        });
        
        if (response.ok) {
          const notification = document.getElementById('cart-notification');
          notification.classList.add('visible', 'success');
          setTimeout(() => {
            notification.classList.remove('visible');
          }, 3000);
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
      }
    });
  });

  // Add to Wishlist functionality
  document.querySelectorAll('.add-to-wishlist').forEach(button => {
    button.addEventListener('click', async () => {
      const productId = button.dataset.productId;
      try {
        const response = await fetch(`/customer/wishlist/add/${productId}`, {
          method: 'POST'
        });
        
        if (response.ok) {
          const notification = document.getElementById('wishlist-notification');
          notification.classList.add('visible', 'success');
          setTimeout(() => {
            notification.classList.remove('visible');
          }, 3000);
        }
      } catch (error) {
        console.error('Error adding to wishlist:', error);
      }
    });
  });
</script>